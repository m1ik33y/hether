{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/js/(.*)$",
      "dest": "/api/asset?file=$1&type=js"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/api/asset?file=$1&type=css"
    },
    {
      "src": "^/(.*)$",
      "continue": true
    }
  ]
}