{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/web\\.structure\\.jshether/(.*)$",
      "dest": "/api/asset?file=$1&type=js"
    },
    {
      "src": "^/web\\.structure\\.cshether/(.*)$",
      "dest": "/api/asset?file=$1&type=css"
    },
    {
      "src": "^/(.*)$",
      "continue": true
    }
  ]
}
